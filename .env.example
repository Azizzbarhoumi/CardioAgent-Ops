# MLflow tracking server and logged analysis experiment
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_PUBLIC_URL=http://localhost:5000
# MLFLOW_UI_URI remains supported as a legacy alias for MLFLOW_PUBLIC_URL.
MLFLOW_UI_URI=http://localhost:5000
MLFLOW_SUPPRESS_PRINTING_URL_TO_STDOUT=true

# API/UI connection
API_URL=http://localhost:8000

# Exported inference models
MODEL_DIR=audio_engine/artifacts/models
MODEL_MANIFEST_PATH=audio_engine/artifacts/models/model_manifest.json
SVM_LINEAR_MODEL_PATH=audio_engine/artifacts/models/svm_linear.joblib
SVM_RBF_MODEL_PATH=audio_engine/artifacts/models/svm_rbf.joblib
DECISION_TREE_MODEL_PATH=audio_engine/artifacts/models/decision_tree.joblib
CNN_MODEL_PATH=audio_engine/artifacts/models/cnn_custom.keras
# Optional direct MLflow model URIs or best-logged-model fallback for SVM
# SVM_LINEAR_MLFLOW_MODEL_URI=models:/m-...
# SVM_RBF_MLFLOW_MODEL_URI=models:/m-...
MLFLOW_RESOLVE_BEST_MODELS=false

# Upload and duration limits
API_MAX_UPLOAD_BYTES=20971520
MIN_AUDIO_SECONDS=0.25
MAX_AUDIO_SECONDS=120
