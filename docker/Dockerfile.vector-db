# ──────────────────────────────────────────────
# Dockerfile.vector-db  (Service 2)
# Base Vectorielle RAG — Qdrant
# ──────────────────────────────────────────────
FROM qdrant/qdrant:latest

# Copy custom Qdrant configuration (collection defaults, CORS, etc.)
COPY docker/qdrant/config.yaml /qdrant/config/production.yaml

EXPOSE 6333 6334

# Default entrypoint from the base image is preserved

