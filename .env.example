# Copy to .env (optional). docker compose and the local API both read it.
# ---- Ports published on the host (docker compose)
APP_PORT=3000
API_PORT=8000
MLFLOW_PORT=5000

# ---- MLflow
# Local runs (API/notebooks outside Docker). Inside Docker the API uses http://mlflow-server:5000.
MLFLOW_TRACKING_URI=http://localhost:5000
# Address YOUR BROWSER uses to open MLflow links (3-fold results, train vs test, analysis runs).
MLFLOW_PUBLIC_URL=http://localhost:5000
MLFLOW_SUPPRESS_PRINTING_URL_TO_STDOUT=true

# ---- API / frontend
# URL the browser uses to reach the API (baked into the React build, and overridable at container start).
VITE_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ---- Models (benchmark v2). Files and thresholds come from model_manifest.json.
MODEL_DIR=audio_engine/artifacts/models
MODEL_MANIFEST_PATH=audio_engine/artifacts/models/model_manifest.json
# Optional overrides (leave commented to use the manifest):
# SVM_LINEAR_MODEL_PATH=  SVM_RBF_MODEL_PATH=  DECISION_TREE_MODEL_PATH=  CNN_MODEL_PATH=  TRANSFER_MODEL_PATH=
# DECISION_TREE_THRESHOLD=  CNN_DECISION_THRESHOLD=  TRANSFER_DECISION_THRESHOLD=

# ---- Upload and duration limits
API_MAX_UPLOAD_BYTES=20971520
MIN_AUDIO_SECONDS=0.25
MAX_AUDIO_SECONDS=120
