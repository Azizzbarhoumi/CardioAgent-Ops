# ──────────────────────────────────────────────
# Dockerfile.api-gateway  (Service 5)
# ──────────────────────────────────────────────
FROM python:3.10-slim AS base

WORKDIR /app

COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api/ ./api/

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]

